# Copy this file to .env.local and fill in your Supabase project's values.
# Find these under Project Settings -> API in the Supabase dashboard.
# .env.local is gitignored (see *.local in .gitignore) — never commit real keys.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server/script-only — used by scripts/seed.mjs, NEVER prefix with VITE_
# (that would bundle it into client-side JS). Find under Project Settings ->
# API -> service_role (or the newer "secret" key). Keep this secret; it
# bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
